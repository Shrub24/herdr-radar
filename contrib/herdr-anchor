#!/bin/sh
# herdr-anchor [--label LABEL] [--] COMMAND [ARG...]
#
# Declares this pane as the workspace's anchor agent once, then replaces
# itself with COMMAND (nvim, jjui, yazi, a shell...). The entry is labelled
# with the workspace's own name, so each space reads as itself: --label or
# HERDR_ANCHOR_LABEL, else the Herdr workspace label, else the repo or
# directory name, else `space`. The label is read once at start; renaming the
# workspace later does not rename the entry. The anchor reports idle
# and never changes state: idle after working/blocked becomes `done` in
# Herdr, which would flag every anchor. Authority is held by --source
# `anchor`, so a real agent started in this pane takes the entry over and
# releasing it brings the anchor back.
#
# Outside a Herdr pane it only runs COMMAND, so the same template line works
# in a plain terminal.
set -eu

label=${HERDR_ANCHOR_LABEL:-}
while [ $# -gt 0 ]; do
  case $1 in
    --label) label=$2; shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || set -- "${SHELL:-sh}"

herdr=${HERDR_BIN_PATH:-herdr}

if [ -z "$label" ] && [ -n "${HERDR_WORKSPACE_ID:-}" ] && command -v jq >/dev/null 2>&1; then
  label=$("$herdr" workspace get "$HERDR_WORKSPACE_ID" 2>/dev/null |
    jq -r '.result.workspace.label // empty' 2>/dev/null) || label=
fi
if [ -z "$label" ]; then
  root=$(git rev-parse --show-toplevel 2>/dev/null || jj root 2>/dev/null || pwd)
  label=${root##*/}
fi
[ -n "$label" ] || label=space

if [ -n "${HERDR_PANE_ID:-}" ]; then
  # A failed report must not stop the management surface from starting.
  "$herdr" pane report-agent "$HERDR_PANE_ID" \
    --source anchor --agent "$label" --state idle >/dev/null 2>&1 || true
  # The marker herdr-radar reads to tell the anchor from a real agent: the
  # label is the workspace name now, so it cannot identify the pane.
  "$herdr" pane report-metadata "$HERDR_PANE_ID" \
    --source anchor --token anchor=1 >/dev/null 2>&1 || true
fi

exec "$@"
